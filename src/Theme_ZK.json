  "fourthLevelElements": "#A0B8CC",
  "textClasses": {
    "callout": {
      "fontFace": "Arial",
      "fontSize": 28,
      "color": "#002857"
    },
    "title": {
      "fontFace": "'Arial Black'",
      "fontSize": 12,
      "color": "#002857"
    },
    "header": {
      "fontFace": "Arial",
      "fontSize": 11,
      "color": "#002857"
    },
    "label": {
      "fontFace": "Arial",
      "fontSize": 10,
      "color": "#002857"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "background": {
              "solid": {
                "color": "#F6F3F1"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Arial",
            "bold": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#F6F3F1"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCEBF3"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B839A"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B839A"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#D0DDE8"
              }
            },
            "gridlineStyle": "solid"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 9
          }
