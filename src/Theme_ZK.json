            "outlineColor": {
              "solid": {
                "color": "#D0DDE8"
              }
            },
            "rowPadding": 4
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            },
            "bold": true
          }
        ],
        "grand-total": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "backColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "bold": true
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D0DDE8"
              }
