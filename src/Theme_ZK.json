{
  "name": "Theme ZK",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/refs/heads/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.155.json",
  "dataColors": [
    "#0068BD",
    "#FECFBB",
    "#1E8C45",
    "#7C5BD9",
    "#002857",
    "#6B839A",
    "#004E8C",
