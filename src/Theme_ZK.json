            "transparency": 0
          }
        ],
        "text": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "bold": true
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "pages": [
          {
            "showHiddenPages": false,
            "showTooltipPages": false,
            "showPage": false
          }
        ]
      }
    },
    "bookmarkNavigator": {
      "*": {}
    }
  }
