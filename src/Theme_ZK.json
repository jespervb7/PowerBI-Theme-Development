        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6B839A"
              }
            },
            "fontFamily": "Arial"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true,
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "backColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            },
            "fontFamily": "Arial",
            "bold": true
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D0DDE8"
              }
