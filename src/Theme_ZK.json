        "label": [
          {
            "$id": "default",
            "show": true,
            "position": "aboveValue",
            "heading": "Normal",
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 24,
            "textWrap": true,
            "transparency": 0
          }
        ],
        "divider": [
          {
            "$id": "default",
            "show": true,
            "dividerColor": {
              "solid": {
                "color": "#FECFBB"
              }
            },
            "dividerLineStyle": "solid",
            "dividerWidth": 3,
            "dividerTransparency": 30,
            "dividerIgnorePadding": false
          }
        ],
        "referenceLabelTitle": [
          {
            "$id": "default",
            "show": true,
            "titleContentType": "fieldName",
            "titleFontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "titleFontFamily": "Arial",
            "titleFontSize": 11,
            "titleBold": false,
            "titleItalic": false,
            "titleUnderline": false,
            "titleTransparency": 40,
            "textWrap": true
          }
        ],
        "referenceLabelValue": [
          {
            "$id": "default",
            "show": true,
            "valueBold": true,
            "valueFontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "valueFontFamily": "Arial",
            "valueFontSize": 11,
            "valuePrecision": 1
          }
        ],
        "referenceLabel": [
          {
            "backgroundShow": false,
            "paddingUniform": 8,
            "paddingIndividual": false,
            "rectangleRoundedCurve": 6
          }
        ],
        "referenceLabelLayout": [
          {
            "arrangement": "rows",
            "position": "below",
            "style": "sentence",
            "labelSpace": 4,
            "outerPadding": 8,
            "customizePadding": false
          }
        ],
        "layout": [
          {
            "$id": "default",
            "style": "Cards",
            "calloutSize": 65,
            "customizePadding": true,
            "paddingIndividual": false,
            "paddingUniform": 16,
            "cellPadding": 12,
            "autoGrid": true
          }
        ],
        "padding": [
          {
            "$id": "default",
            "paddingSelection": "Custom",
            "paddingUniform": 16,
            "paddingIndividual": false
          }
        ],
        "spacing": [
          {
            "verticalSpacing": 6
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "selection": [
          {
            "selectAllCheckboxEnabled": true,
            "singleSelect": true
          }
        ],
        "data": [
          {
            "mode": "Dropdown"
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 10
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "shape": [
          {
            "tileShape": "pill"
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#0068BD"
              }
