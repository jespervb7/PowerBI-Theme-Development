        "accentBar": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0068BD"
              }
            },
            "position": "Left"
          }
        ],
        "value": [
          {
            "$id": "default",
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0068BD"
