        ],
        "filterCard": [
          {
            "$id": "Available",
            "fontFamily": "Arial",
            "foregroundColor": {
              "solid": {
                "color": "#002857"
              }
            },
            "textSize": 10,
            "borderColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            }
          },
          {
            "$id": "Applied",
            "fontFamily": "'Arial Black'",
            "foregroundColor": {
              "solid": {
                "color": "#00345f"
              }
            },
            "textSize": 9,
            "backgroundColor": {
              "solid": {
                "color": "#DCEBF3"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 16,
            "left": 16,
            "bottom": 16,
            "right": 16
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F3F1"
              }
            },
            "transparency": 100
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F7FA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#002857"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 28,
            "bold": true
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B839A"
              }
            },
            "fontFamily": "Arial",
            "fontSize": 10
          }
        ]
      }
    },
    "multiRowCard": {
