                  {
                    "value": " to see which fake messages are circulating.",
                    "textStyle": {
                      "fontFamily": "PT Sans, serif",
                      "fontSize": "16px",
                      "color": "#002857"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "We never ask you to provide personal or financial information by email of WhatsApp. ",
                    "textStyle": {
                      "fontFamily": "PT Sans, serif",
                      "fontSize": "16px",
                      "color": "#002857"
                    }
                  },
                  {
                    "value": "Always check the sender and the account number. Only pay us at NL 58 INGB 0000 0030 50",
