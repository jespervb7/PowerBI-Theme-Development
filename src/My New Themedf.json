{
  "name": "My New Themedf",
  "visualStyles": {
    "slicer": {
      "*": {
        "selection": [
          {
            "selectAllCheckboxEnabled": true,
            "singleSelect": true
          }
        ],
        "stylePreset": [
          {
            "name": "dropdown"
          }
        ],
        "data": [
          {
            "mode": "Dropdown"
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "shadow": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "fill": [
          {
            "fillColor": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 1,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        ],
        "shape": [
          {
            "tileShape": "pill"
          }
        ],
        "*": [
          {
            "background": {
              "solid": {
                "color": {
                  "expr": {
                    "ThemeDataColor": {
                      "ColorId": 1,
                      "Percent": 0
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}